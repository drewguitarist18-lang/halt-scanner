{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "halt-scanner",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "no_bundle": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SEEN",
      "id": "REPLACE_AFTER_CREATE"
    }
  ],
  "vars": {
    "CHANNEL_IDS": "1551595288777596931,1551607291378143314"
  }
}
